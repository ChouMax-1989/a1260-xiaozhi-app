    <string name="feature_media_heading">媒体按键</string>
    <string name="feature_media_help">请先在播放器中打开音乐。按键交给系统当前媒体会话处理；发送按键不代表已确认播放，实际响应取决于播放器。</string>
    <string name="feature_media_play">播放</string>

    <string name="feature_agent_heading">智能体与角色</string>
    <string name="feature_agent_help">角色、声音和设备归属由你的小智服务器账号管理。下面会在系统浏览器打开官方控制台，请在浏览器登录自己的账号。</string>
    <string name="feature_open_agents">打开官方智能体管理</string>

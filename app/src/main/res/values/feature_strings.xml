    <string name="feature_plugin_heading">内置插件</string>
    <string name="feature_plugin_help">开关会保存。关闭后，该组工具不再开放给会话，也不能通过下方按钮调用。此版本仅运行内置工具。</string>
    <string name="feature_plugin_device">设备信息 · 音量、电量、可用内存</string>
